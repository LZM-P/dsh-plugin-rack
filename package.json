{
  "name": "dsh-plugin-rack",
  "version": "0.1.10",
  "type": "module",
  "description": "DSH 插件管理：所有插件一屏看完，一个开关直接开关，更新完自动热替换不用重启。/ Plugin rack for DSH: every plugin in one list with a power switch, an auto/manual flag that scopes the one-click bulk actions, and hot-swapped updates that need no restart.",
  "author": "Jaside (LZM-P)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LZM-P/dsh-plugin-rack.git"
  },
  "homepage": "https://github.com/LZM-P/dsh-plugin-rack#readme",
  "bugs": "https://github.com/LZM-P/dsh-plugin-rack/issues",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dashboard",
    "plugin-manager",
    "hot-reload",
    "upgrade",
    "uninstall",
    "skill",
    "skills",
    "skill-manager"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "lib/*.d.ts",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "node scripts/build-client.mjs --check && node test/self-check.mjs && node test/behaviour.mjs && node test/spec.mjs && node test/skills.mjs && node test/migration.mjs",
    "test": "node scripts/build-client.mjs --check && node test/self-check.mjs && node test/behaviour.mjs && node test/spec.mjs && node test/batch-fallback.mjs && node test/migration.mjs && node test/skills.mjs && node test/client.mjs && node test/job-background.mjs && node test/download.mjs && node test/pnpm-command.mjs",
    "lint": "eslint .",
    "types": "tsc -p tsconfig.json",
    "build": "node scripts/build-client.mjs",
    "release": "node scripts/release.mjs",
    "tag": "node scripts/tag.mjs",
    "bump": "npm version patch --no-git-tag-version"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible",
        "0.2.2-rc.2": "compatible",
        "0.2.2-rc.3": "compatible"
      }
    }
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "typescript": "^5.6.3"
  }
}
